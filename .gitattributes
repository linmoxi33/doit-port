# Every text file is stored with LF. A Windows checkout that produced CRLF
# would change the hash of every `inputs=` file, and the cache would silently
# never hit on a machine of the other flavour.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf

*.png binary
*.zip binary
*.whl binary
*.db binary
